# Copy to .env and fill in real values. .env is git-ignored; this template is committed.

DJANGO_SECRET_KEY=change-me
# Set to False on the live server
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=www.zacocomputer.com,zacocomputer.com

# SMTP (Gmail app password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Form notification recipients (comma-separated for multiple)
# Contact pages, ITAD, newsletter, Build Your Server
CONTACT_RECEIVER_EMAIL=
# Quote / rent / PPC / VMware quote requests
QUOTE_RECEIVER_EMAIL=info@zacocomputer.com
# Checkout bank-transfer order notifications
ORDER_RECEIVER_EMAIL=info@zacocomputer.com

# Google reCAPTCHA v2
RECAPTCHA_PUBLIC_KEY=
RECAPTCHA_PRIVATE_KEY=
